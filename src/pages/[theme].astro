---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, themes, type Theme } from '../data/themes';
import { sitePath } from '../lib/paths';

export function getStaticPaths() { return themes.map((theme) => ({ params: { theme: theme.slug }, props: { theme } })); }
interface Props { theme: Theme; }
const { theme } = Astro.props;
const category = categories.find((item) => item.id === theme.category)!;
const themeNumber = themes.findIndex((item) => item.slug === theme.slug) + 1;
---
<BaseLayout title={theme.name} description={`${theme.description} Conheça este tema para uma futura contagem regressiva.`}>
  <div class="theme-page shell" style={`--card-bg:${theme.colors.background};--card-accent:${theme.colors.accent};--card-soft:${theme.colors.soft}`}>
    <nav class="breadcrumbs" aria-label="Você está aqui"><a href={sitePath()}>Todos os temas</a><span aria-hidden="true">/</span><span>{theme.name}</span></nav>
    <section class="theme-hero" aria-labelledby="theme-title"><div class="theme-hero-copy"><p class="eyebrow">{category.name} <span aria-hidden="true">/</span> TEMA {String(themeNumber).padStart(2, '0')}</p><h1 id="theme-title">{theme.name}<span class="title-period">.</span></h1><p class="theme-intro">{theme.description}</p><a class="back-link" href={sitePath()}>← Ver todos os temas</a></div><div class="theme-art" aria-hidden="true"><span class="theme-art-circle"></span><span class="theme-art-small"></span><span class="theme-art-glyph">✳</span><span class="theme-art-label">CONTAGEM / {String(themeNumber).padStart(2, '0')}</span></div></section>
    <section class="theme-details" aria-label="Sobre este tema"><div><p class="eyebrow">SOBRE A EXPERIÊNCIA</p><h2>Um momento para chamar de seu.</h2></div><div><p>Esta página apresenta o tema {theme.name.toLowerCase()}. Em uma próxima etapa, você poderá criar um evento com título, data, horário e fuso horário, acompanhar a contagem e compartilhar o link com outras pessoas.</p><p>O horário escolhido será associado ao fuso do evento para que a mesma ocasião possa ser acompanhada de lugares diferentes.</p><p class="coming-note">A criação e a contagem ainda não estão disponíveis. Quando forem adicionadas, essas funções exigirão JavaScript no navegador.</p></div></section>
    <div class="theme-next"><span>CONTINUE EXPLORANDO</span><a href={sitePath()}>Descubra outra ocasião <span aria-hidden="true">↗</span></a></div>
  </div>
</BaseLayout>

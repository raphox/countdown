---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeCard from '../components/ThemeCard.astro';
import { categories, themes } from '../data/themes';
import { createSearchIndex } from '../lib/theme-search';
const searchIndex = createSearchIndex(themes, categories);
---
<BaseLayout title="Escolha uma ocasião" description="Explore quinze temas para futuras contagens regressivas de celebrações, conquistas, encontros e eventos.">
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="eyebrow hero-eyebrow"><span class="eyebrow-line"></span> MOMENTOS QUE MERECEM SER CONTADOS</p><h1 id="hero-title">Cada ocasião tem <em>seu tempo.</em></h1><p class="hero-lead">Encontre um tema para o próximo momento especial. Nossa coleção reúne celebrações, conquistas, encontros e eventos em um só lugar.</p><a class="primary-link" href="#temas">Explorar os 15 temas <span aria-hidden="true">↘</span></a></div>
    <div class="hero-visual" aria-hidden="true"><span class="hero-visual-ring ring-one"></span><span class="hero-visual-ring ring-two"></span><span class="hero-visual-sun"></span><span class="hero-visual-center">o tempo<br />de celebrar<span>✳</span></span><span class="hero-visual-caption">UM NOVO MOMENTO SE APROXIMA ·</span></div>
  </section>
  <section id="temas" class="catalog shell" aria-labelledby="catalog-title"><div class="section-heading"><div><p class="eyebrow">A COLEÇÃO</p><h2 id="catalog-title">Uma ocasião para cada história.</h2></div><p>Escolha entre 15 temas para conhecer a proposta de cada página.</p></div>
    <div id="theme-search" class="theme-search" hidden>
      <label for="theme-query">Buscar tema</label>
      <div class="search-controls"><input id="theme-query" type="search" placeholder="Aniversário, formatura, tecnologia…" autocomplete="off" /><button id="clear-search" type="button">Limpar</button></div>
      <p id="search-count" role="status" aria-live="polite" aria-atomic="true">15 temas encontrados</p>
      <div id="search-empty" hidden><p>Nenhum tema encontrado</p><button id="show-all" type="button">Ver todos os temas</button></div>
    </div>
    <script id="theme-search-index" type="application/json" set:html={JSON.stringify(searchIndex)} />
    <div id="search-results" class="card-grid search-results" hidden></div>
    {categories.map((category) => { const entries = themes.filter((theme) => theme.category === category.id); return <section class="category" aria-labelledby={`cat-${category.id}`}><div class="category-heading"><div><span class="category-index">0{categories.indexOf(category) + 1} / 04</span><h3 id={`cat-${category.id}`}>{category.name}</h3></div><p>{category.description}</p></div><div class="card-grid">{entries.map((theme) => <ThemeCard theme={theme} number={themes.indexOf(theme) + 1} />)}</div></section>; })}
  </section>
  <section class="info-band"><div class="shell info-inner"><span aria-hidden="true" class="info-symbol">✳</span><div><p class="eyebrow">EM CONSTRUÇÃO</p><h2>Por enquanto, explore os temas.</h2><p>As páginas já podem ser abertas e compartilhadas como referência. Criar um evento, escolher data e fuso horário e acompanhar a contagem exigirão JavaScript e serão adicionados nas próximas etapas.</p></div></div></section>
</BaseLayout>

<script>
  import { normalizeSearch, searchThemes, type SearchEntry } from '../lib/theme-search';
  const controls = document.querySelector<HTMLElement>('#theme-search');
  const input = document.querySelector<HTMLInputElement>('#theme-query');
  const clear = document.querySelector<HTMLButtonElement>('#clear-search');
  const recovery = document.querySelector<HTMLButtonElement>('#show-all');
  const results = document.querySelector<HTMLElement>('#search-results');
  const count = document.querySelector<HTMLElement>('#search-count');
  const empty = document.querySelector<HTMLElement>('#search-empty');
  const data = document.querySelector('#theme-search-index');
  if (controls && input && clear && recovery && results && count && empty && data) {
    const index: SearchEntry[] = JSON.parse(data.textContent ?? '[]');
    const groups = [...document.querySelectorAll<HTMLElement>('.category')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-theme-slug]')];
    const homes = cards.map((card) => ({ card, parent: card.parentElement! }));
    function update() {
      if (!input || !results || !count || !empty) return;
      const matches = searchThemes(index, input.value);
      const active = Boolean(normalizeSearch(input.value));
      groups.forEach((group) => { group.hidden = active; });
      cards.forEach((card) => { card.hidden = active; });
      if (active) {
        for (const slug of matches) {
          const card = cards.find((entry) => entry.dataset.themeSlug === slug);
          if (card) { card.hidden = false; results.append(card); }
        }
      } else {
        homes.forEach(({ card, parent }) => { card.hidden = false; parent.append(card); });
      }
      results.hidden = !active || matches.length === 0;
      empty.hidden = matches.length !== 0;
      count.textContent = `${matches.length} ${matches.length === 1 ? 'tema encontrado' : 'temas encontrados'}`;
    }
    function reset() { if (input) { input.value = ''; update(); input.focus(); } }
    input.addEventListener('input', update);
    clear.addEventListener('click', reset);
    recovery.addEventListener('click', reset);
    update();
    controls.hidden = false;
  }
</script>

# Origem pública do site, sem barra final.
SITE_URL=https://contagem.vivace-softwares.com.br
# Use / para domínio raiz ou /countdown/ para subdiretório.
BASE_PATH=/
# Explicit production origin accepted when opening event links. Keep aligned with SITE_URL.
PUBLIC_SITE_ORIGIN=https://contagem.vivace-softwares.com.br
# Public OSM tiles: interactive use only; attribution and origin referrer are included.
PUBLIC_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Photon works without registration/API key/backend. Empty also uses this default.
# Replace with a compatible GeoJSON or [{display_name,lat,lon}] endpoint if needed.
PUBLIC_GEOCODER_URL=https://photon.komoot.io/api/
# Local dev-only adapter demonstration: filled | no-fill | error. Empty means off.
PUBLIC_AD_TEST_MODE=
